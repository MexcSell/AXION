# Copy to .env (chmod 600). Never commit .env.
DATABASE_URL=postgres://axion:<password>@127.0.0.1:5432/axion
TEST_DATABASE_URL=postgres://axion:<password>@127.0.0.1:5432/axion_test
E2E_DATABASE_URL=postgres://axion:<password>@127.0.0.1:5432/axion_e2e
RESTORE_DATABASE_URL=postgres://axion:<password>@127.0.0.1:5432/axion_restore_check
HOST=127.0.0.1
PORT=5191
# c49: audit-chain anchor (see server/docs/audit-anchor.md). Key: at least 32 bytes, e.g. `openssl rand -hex 32`. Environment only.
# AUDIT_ANCHOR_KEY=
# AUDIT_ANCHOR_FILE=./data/audit-anchors.jsonl
# REQUIRED with the key: a fixed deployment id (not derived from the database name, so a restore into another database still verifies).
# AUDIT_ANCHOR_DOMAIN=axion-prod

# c64: restructure guardrails for organisation proposals (operator settings, never routes). 0 or unset = not enforced (the escalation depth: unset = 6).
# ORG_COOLDOWN_HOURS=24          # after an approved org revision, no new proposal for this long (only the undo of the last change is exempt)
# ORG_CHURN_BUDGET=6             # reporting lines (added + removed + re-pointed) approved proposals may change per window, a new one included
# ORG_CHURN_WINDOW_HOURS=168     # the window of the budget (default one week when a budget is set)
# ORG_MAX_ESCALATION_LEVELS=6    # a changed chain of managers must reach the GM within this many levels (unset = 6, 0 = not enforced)
