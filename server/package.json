{
  "name": "axion-server",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "tsx --env-file=.env src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "migrate": "tsx --env-file=.env src/migrate-cli.ts",
    "admin:approve-device": "tsx --env-file=.env src/cli/approve-device.ts",
    "demo:seed": "tsx --env-file=.env src/cli/demo.ts seed",
    "demo:clear": "tsx --env-file=.env src/cli/demo.ts clear",
    "e2e:serve": "tsx --env-file=.env src/cli/e2e-serve.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
