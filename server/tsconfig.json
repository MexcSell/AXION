{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": { "@/*": ["../web/src/*"] },
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["src", "test", "../shared/contracts/src", "../web/src/features/mission/staffing-plan.ts"]
}
