# The AXION evolution runner (evolve step 2): claims owner `improve` missions, has the Workshop's engineer change the code,
# checks it and hands it to the Guard (axion-guard). Installed to /etc/systemd/system by evolve/install.sh, never enabled
# or started by it (R36: Claude Code enables and starts it after the smoke: systemctl enable --now axion-evolve).
# KillMode=process: a stop signals the runner only. A Guard deploy it started keeps running to its own end (a killed Guard
# leaves an unfinished deploy that needs `axion-guard rollback`); the next start waits for it and settles the mission from
# the Guard's history, then sweeps the runner's leftover containers. The runner starts the Guard detached (its own
# session, output to a file), so neither the stop nor a dying runner can signal it or break its output.
[Unit]
Description=AXION evolution runner (axion-evolve)
After=docker.service network-online.target postgresql.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/axion-evolve run
# after every stop or crash: no Workshop container (it holds TOKEN1, its wall cap lives in the runner) outlives the runner
ExecStopPost=/usr/local/bin/axion-evolve sweep
Restart=on-failure
RestartSec=30
KillMode=process
TimeoutStopSec=90
# the sbin dirs too: the Guard it starts runs backup.sh, which needs /usr/sbin/runuser (first live mission M-137, 2026-11-27)
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
